<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- hesperd runs with the hardened runtime. Agents are its children, so it is
     their responsible process: without these an agent's osascript (Apple
     Events) is refused instead of asking for Automation consent, and an
     agent's microphone use (Claude Code's /voice) is refused instead of
     asking for Microphone consent. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
