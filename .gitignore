.DS_Store
__pycache__/
*.pyc
*.log

# Release and build outputs (the release workflow writes dist/ at the root)
/dist/
DerivedData/
xcuserdata/
*.xcuserstate

# Local state, credentials and signing material: never commit these
.env
.env.*
*.credentials.json
*.credentials.json.lock
*.p8
*.p12
*.pem
*.key
*.cer

# Editors
.idea/
.vscode/
*.swp

# Claude Code: worktrees and personal files stay local; .claude/settings.json
# and .claude/hooks/ are shared with everyone who works on the repo
/.claude/*
!/.claude/settings.json
!/.claude/hooks/
CLAUDE.local.md
