# Copy to deploy/local.env (ignored by Git) and fill in for your server.
# scripts/deploy.py (just deploy, just tls, ...) reads it; exported RELAY_*
# variables override it. See docs/deployment.md.

# The relay's public name (DNS A record to your server).
RELAY_DOMAIN=relay.example.com
# SSH destination of the server.
RELAY_SERVER=server.example.com
RELAY_SSH_USER=root

# The nginx + certbot stack already running there.
RELAY_PROXY_DIR=/opt/proxy
RELAY_PROXY_NETWORK=proxy_default
RELAY_PROXY_NGINX=proxy-nginx-1
# RELAY_PROXY_CONF_DIR=/opt/proxy/nginx/conf.d
# RELAY_PROXY_CONF_NAME=hesper-relay.conf
# RELAY_PROXY_COMPOSE_ARGS=--env-file .env.production
# RELAY_PROXY_CERTBOT=certbot

# Where the relay lives on the server.
# RELAY_REMOTE_DIR=/opt/hesper-relay
# RELAY_COMPOSE_PROJECT=hesper-relay
