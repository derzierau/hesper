<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app group the extensions share (HesperSurfaces.AppGroup). The
	     rest of the Info.plist is generated from INFOPLIST_KEY_* settings. -->
	<key>HesperAppGroup</key>
	<string>$(HESPER_APP_GROUP)</string>
	<!-- The Neon faces in App/Fonts (HesperDesign.Typeface); there is no
	     INFOPLIST_KEY_* setting for this key. -->
	<key>UIAppFonts</key>
	<array>
		<string>SpaceGrotesk-Bold.ttf</string>
		<string>JetBrainsMono-Regular.ttf</string>
	</array>
	<!-- The relay's sign-in page returns to hesper-ios://auth
	     (ASWebAuthenticationSession; relay/docs/protocol.md). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hesper-ios</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
